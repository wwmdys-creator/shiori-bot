# =============================================================================
# 適用箇所: メンション応答生成の直前（ResponseGenerator.generate() 呼び出し前）
# response_mode 判定の後、プロンプト構築の前に挿入
#
# ⚠️ N-03 最重要: pop() で取得。get() は絶対禁止。
# ⚠️ N-04 必須: 記録モードでは再登録。
LEVEL_UP_FLAG_CONSUMPTION = """
        # ===== Phase 4: 昇格フラグ消費（§9.5, N-03, N-04） =====
        # ⚠️ CRITICAL: pop() 必須。get() を使うと昇格演出が無限ループする。
        level_up_info = self.level_up_pending.pop(user_id, None)

        level_up_hint = ""
        if level_up_info is not None:
            if response_mode == "free":
                # 自由モード: 昇格演出をプロンプトに追加
                level_up_hint = LEVEL_UP_HINT_PROMPTS.get(
                    level_up_info["new_level"], ""
                )
                logger.info(
                    f"[LevelUp] Consuming flag for {user_id}: "
                    f"Lv{level_up_info['new_level']} hint applied"
                )
            elif response_mode == "record":
                # ⚠️ N-04: 記録モードでは演出しない。フラグを再登録。
                self.level_up_pending[user_id] = level_up_info
                logger.info(
                    f"[LevelUp] Re-registered flag for {user_id}: "
                    f"record mode, deferring to next free response"
                )
"""


