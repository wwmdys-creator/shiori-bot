# Shiori Discord Bot - Environment Variables Template
# Copy this file to .env and fill in the values

# ===================
# Required Settings
# ===================

# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Anthropic API Key (from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===================
# Optional Settings
# ===================

# Main channel category ID for passive monitoring (Q4)
# Only messages in channels under this category will be monitored
# If not set, passive monitoring is disabled
MAIN_CHANNEL_CATEGORY_ID=

# Rate limit cooldown in seconds per channel (Q17, default: 30)
RATE_LIMIT_SECONDS=30

# Number of previous messages to include as context (Q16, default: 20)
CONTEXT_MESSAGE_COUNT=20

# Number of messages to fetch on startup (Q24, default: 100)
STARTUP_MESSAGE_COUNT=100

# ===================
# Advanced Settings
# ===================

# Claude model to use (default: claude-haiku-4-5-20250929)
# Q10: Haiku 4.5 only for cost efficiency
CLAUDE_MODEL=claude-haiku-4-5-20250929

# Maximum tokens for Claude response (default: 1024)
MAX_TOKENS=1024

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
